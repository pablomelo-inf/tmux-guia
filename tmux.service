# User service: starts tmux at login, and tmux-continuum restores the saved sessions.
# On shutdown it saves first, then exits. Install with: "tm boot".
[Unit]
Description=tmux server (sessões restauradas pelo tmux-continuum)

[Service]
Type=forking
ExecStart=/usr/bin/tmux new-session -d
ExecStop=%h/.tmux/plugins/tmux-resurrect/scripts/save.sh
ExecStop=/usr/bin/tmux kill-server
RestartSec=2

[Install]
WantedBy=default.target
